# Office lock files and temporary or backup files
~$*
.~lock.*
*.tmp
*.temp
*.bak
*.swp
*~

# OneDrive and other sync conflict copies (also check for files named like "name-<PC name>.ext")
*conflicted copy*

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log
